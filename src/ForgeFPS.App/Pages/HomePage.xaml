<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ForgeFPS.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="ForgeFPS" />
        <TextBlock Grid.Row="1" Text="Otimizador de Games para Windows e Counter-Strike 2" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Text="Analise seu hardware, aplique otimizacoes seguras com backup e reverta quando quiser. Sem promessa de FPS milagrosa: cada ganho e medido." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600" Margin="0,8,0,0" />
        <Button Grid.Row="3" x:Name="AnalyzeButton" Content="Analisar meu PC" FontSize="16" Padding="32,16,32,16" HorizontalAlignment="Left" Click="AnalyzeButton_Click" Margin="0,16,0,0" />
        <TextBlock Grid.Row="4" x:Name="StatusText" Text="" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="600" />
        <ProgressBar Grid.Row="5" x:Name="ProgressBar" Visibility="Collapsed" IsIndeterminate="True" Width="300" HorizontalAlignment="Left" Margin="0,8,0,0" />
    </Grid>
</Page>